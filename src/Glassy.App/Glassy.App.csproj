<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041.0 (not plain net8.0-windows) so Windows.Devices.Geolocation (WinRT, for the Weather
         panel's "use my current location") is directly callable - the .NET SDK auto-provides the CsWinRT
         projection for this TFM, no extra package needed. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Defender ASR here blocks freshly built .exe files, so the app runs as: dotnet Glassy.App.dll -->
    <UseAppHost>false</UseAppHost>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Glassy.App</RootNamespace>
    <TieredPGO>false</TieredPGO>
    <TieredCompilation>true</TieredCompilation>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Shown on the Settings "About" page; bump this on each tagged release (currently v0.6.2). -->
    <Version>0.6.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Glassy.Core\Glassy.Core.csproj" />
  </ItemGroup>
</Project>
